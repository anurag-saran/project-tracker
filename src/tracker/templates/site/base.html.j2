<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{% block title %}OSS Project Tracker{% endblock %}</title>
  <style>
    :root {
      --bg: #0f1419;
      --panel: #1a222c;
      --text: #e7ecf1;
      --muted: #9aa7b5;
      --accent: #3d9cfd;
      --border: #2a3542;
      --mono: "IBM Plex Mono", ui-monospace, monospace;
      --sans: "IBM Plex Sans", "Segoe UI", sans-serif;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: var(--sans);
      background:
        radial-gradient(1200px 600px at 10% -10%, #1b2a3a 0%, transparent 55%),
        radial-gradient(900px 500px at 100% 0%, #1a2830 0%, transparent 50%),
        var(--bg);
      color: var(--text);
      line-height: 1.55;
      min-height: 100vh;
    }
    a { color: var(--accent); text-decoration: none; }
    a:hover { text-decoration: underline; }
    header {
      border-bottom: 1px solid var(--border);
      padding: 1.25rem 1.5rem;
      display: flex;
      gap: 1.5rem;
      align-items: baseline;
      flex-wrap: wrap;
    }
    header .brand {
      font-family: var(--mono);
      font-weight: 600;
      letter-spacing: 0.02em;
      font-size: 1.05rem;
    }
    nav { display: flex; gap: 1rem; flex-wrap: wrap; }
    nav a { color: var(--muted); font-size: 0.95rem; }
    nav a:hover { color: var(--text); }
    main {
      max-width: 920px;
      margin: 0 auto;
      padding: 2rem 1.5rem 4rem;
    }
    h1, h2, h3 { line-height: 1.25; }
    h1 { font-size: 1.75rem; margin: 0 0 0.5rem; }
    h2 {
      font-size: 1.25rem;
      margin-top: 2rem;
      padding-bottom: 0.35rem;
      border-bottom: 1px solid var(--border);
    }
    .lede { color: var(--muted); margin-bottom: 1.75rem; }
    .project-list { list-style: none; padding: 0; margin: 0; }
    .project-list li {
      background: color-mix(in srgb, var(--panel) 88%, transparent);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 1rem 1.15rem;
      margin-bottom: 0.75rem;
    }
    .project-list strong { font-size: 1.05rem; }
    .meta { color: var(--muted); font-size: 0.9rem; margin-top: 0.25rem; }
    article.markdown {
      background: color-mix(in srgb, var(--panel) 70%, transparent);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 1.25rem 1.4rem;
    }
    article.markdown pre, article.markdown code {
      font-family: var(--mono);
      font-size: 0.9em;
    }
    article.markdown ul { padding-left: 1.2rem; }
    footer {
      border-top: 1px solid var(--border);
      color: var(--muted);
      font-size: 0.85rem;
      padding: 1rem 1.5rem 2rem;
      text-align: center;
    }
  </style>
</head>
<body>
  <header>
    <a class="brand" href="index.html">OSS Project Tracker</a>
    <nav>
      <a href="learning.html">learning</a>
      <a href="monthly.html">monthly</a>
      {% for p in projects %}
      <a href="{{ p.name }}/index.html">{{ p.name }}</a>
      {% endfor %}
    </nav>
  </header>
  <main>
    {% block content %}{% endblock %}
  </main>
  <footer>Generated by tracker site · {{ generated_at }}</footer>
</body>
</html>
